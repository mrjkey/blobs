[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/pause/pause_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://themes/neon/menu_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://ui/menus/menu_frame.gd" id="9_frame"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 30
script = ExtResource("1_menu")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="MenuFrame" type="Control" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("9_frame")
background = false

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.01, 0.04, 0.72)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Root/Center"]
layout_mode = 2
theme_type_variation = &"MenuPanel"

[node name="Column" type="VBoxContainer" parent="Root/Center/Panel"]
custom_minimum_size = Vector2(420, 0)
layout_mode = 2

[node name="Title" type="Label" parent="Root/Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 64
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Root/Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "RESUME"

[node name="RestartButton" type="Button" parent="Root/Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "RESTART"

[node name="QuitButton" type="Button" parent="Root/Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "QUIT TO LOBBY"

[node name="Hint" type="Label" parent="Root/Center/Panel/Column"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "W/S, arrows or D-pad to choose     Space, Enter or A to pick     Esc, B or Start to resume"
horizontal_alignment = 1

[connection signal="pressed" from="Root/Center/Panel/Column/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Root/Center/Panel/Column/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Root/Center/Panel/Column/QuitButton" to="." method="_on_quit_button_pressed"]
