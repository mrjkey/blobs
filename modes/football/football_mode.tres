[gd_resource type="Resource" script_class="ModeInfo" format=3]

[ext_resource type="Script" path="res://modes/mode_info.gd" id="1_info"]

[resource]
script = ExtResource("1_info")
title = "FOOTBALL"
subtitle = "Push the ball into the other team's goal."
scene = "res://modes/football/football.tscn"
min_slots = 2
max_slots = 4
default_slots = 4
teams = PackedStringArray("BLUE", "RED")
options = PackedStringArray("football_time", "football_goals")
goal = "Push the ball into the other team's goal. The first team to the goal count wins, or the one ahead when time runs out."
move_texts = {
"push": ["KICK", "Blast the ball (and anyone near) away from you"]
}
